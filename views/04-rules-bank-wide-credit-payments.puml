@startuml
!include <archimate/Archimate>
title AI chatbot capability model – bank-wide, credit and payment rules
left to right direction
' Capabilities realise the rules. A rule that relies on an enterprise capability
' is realised by the chatbot and that enterprise capability together.

Grouping(grpChatbot, "AI chatbot capabilities") {
  Strategy_Capability(cap1_1, "1.1 AI use-case inventory & risk classification")
  Strategy_Capability(cap1_4, "1.4 AI conduct management")
  Strategy_Capability(cap3_3, "3.3 Customer insight")
  Strategy_Capability(cap4_1, "4.1 Journey & scope management")
  Strategy_Capability(cap4_2, "4.2 Multilingual & brand voice management")
  Strategy_Capability(cap5_2, "5.2 Conversation context management")
  Strategy_Capability(cap5_3, "5.3 Conversation handling")
  Strategy_Capability(cap5_4, "5.4 Bot–human co-handling")
  Strategy_Capability(cap5_5, "5.5 Human review & approval")
  Strategy_Capability(cap5_6, "5.6 Outcome disposition")
  Strategy_Capability(cap5_7, "5.7 Conversation design governance")
  Strategy_Capability(cap6_1, "6.1 Authoritative knowledge curation")
  Strategy_Capability(cap6_3, "6.3 Approved-answer management")
  Strategy_Capability(cap7_2, "7.2 Evaluation reference management")
}
Grouping(grpRules, "Bank-wide, credit and payment rules") {
  Motivation_Requirement(c1, "C1 AI disclosure")
  Motivation_Constraint(c2, "C2 No personal recommendations")
  Motivation_Constraint(c5, "C5 No creditworthiness assessment")
  Motivation_Constraint(c6, "C6 Responsible credit information")
  Motivation_Requirement(c7, "C7 Payment authorisation")
  Motivation_Requirement(c8, "C8 Scam warning before payment")
  Motivation_Constraint(c9, "C9 Data minimisation")
  Motivation_Constraint(c10, "C10 Purpose limitation across domains")
  Motivation_Requirement(c13, "C13 Complaints in chat are complaints")
  Motivation_Constraint(c22, "C22 No tax advice")
}
Grouping(grpEnterprise, "Enterprise capabilities") {
  Strategy_Capability(d1, "D1 Customer authentication & mandate management")
  Strategy_Capability(d2, "D2 Customer relationship data")
  Strategy_Capability(d3, "D3 Consent & purpose management")
  Strategy_Capability(d4, "D4 Data subject rights management")
  Strategy_Capability(d6, "D6 Complaint management")
  Strategy_Capability(d8, "D8 Fraud & scam management")
  Strategy_Capability(d13, "D13 ICT third-party risk management")
  Strategy_Capability(d14, "D14 Credit origination")
  Strategy_Capability(d15, "D15 Payment initiation")
  Strategy_Capability(d16, "D16 Advisory services")
}

