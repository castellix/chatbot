Rel_Serving(d8, cap8_1, "extends")
Rel_Serving(d9, cap5_3, "extends")
Rel_Serving(d10, cap4_1, "uses")
Rel_Serving(d10, cap6_4, "uses")
Rel_Serving(d11, cap5_5, "extends, agentic")
Rel_Serving(d12, cap1_5, "uses, agentic")
Rel_Serving(d13, cap1_3, "extends")
Rel_Serving(d13, cap8_2, "extends")
Rel_Serving(d14, cap4_1, "uses")
