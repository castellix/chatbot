@startuml
!include <archimate/Archimate>
title AI chatbot capability model – capability map
' Nesting means composition: Level 2 inside Level 1, Level 3 inside Level 2.

Grouping(grp_steer, "Steer & Govern") {
  Strategy_Capability(cap3, "3 Continuous Improvement") {
    Strategy_Capability(cap3_1, "3.1 Feedback capture & triage")
    Strategy_Capability(cap3_2, "3.2 Gap analysis")
    Strategy_Capability(cap3_3, "3.3 Customer insight")
  }
  Strategy_Capability(cap2, "2 Performance & Value Management") {
    Strategy_Capability(cap2_1, "2.1 Outcome KPI management")
    Strategy_Capability(cap2_2, "2.2 Consumption & cost management")
    Strategy_Capability(cap2_3, "2.3 Benefits realisation")
  }
  Strategy_Capability(cap1, "1 AI Governance & Risk Management") {
    Strategy_Capability(cap1_1, "1.1 AI use-case inventory & risk classification")
    Strategy_Capability(cap1_2, "1.2 AI accountability & ownership")
    Strategy_Capability(cap1_3, "1.3 Model risk management")
    Strategy_Capability(cap1_4, "1.4 AI conduct management") {
      Strategy_Capability(cap1_4_1, "Conduct policy definition")
      Strategy_Capability(cap1_4_2, "Conduct requirements intake")
      Strategy_Capability(cap1_4_3, "Constraint register maintenance")
      Strategy_Capability(cap1_4_4, "AI risk appetite setting")
      Strategy_Capability(cap1_4_5, "Mandate & authority management")
      Strategy_Capability(cap1_4_6, "Conduct supervision")
      Strategy_Capability(cap1_4_7, "Conduct breach & remediation")
      Strategy_Capability(cap1_4_8, "Conduct exception management")
    }
    Strategy_Capability(cap1_5, "1.5 AI traceability & audit trail")
    Strategy_Capability(cap1_6, "1.6 AI literacy & competence")
  }
}

Grouping(grp_serve, "Serve") {
  Strategy_Capability(cap6, "6 Knowledge & Content Management") {
    Strategy_Capability(cap6_1, "6.1 Authoritative knowledge curation")
    Strategy_Capability(cap6_2, "6.2 Content lifecycle management")
    Strategy_Capability(cap6_3, "6.3 Approved-answer management")
    Strategy_Capability(cap6_4, "6.4 Regulated instrument information")
  }
  Strategy_Capability(cap5, "5 Conversation Management") {
    Strategy_Capability(cap5_1, "5.1 Conversation lifecycle management")
    Strategy_Capability(cap5_2, "5.2 Conversation context management") {
      Strategy_Capability(cap5_2_1, "Context continuity")
      Strategy_Capability(cap5_2_2, "Resumption & expiry policy")
      Strategy_Capability(cap5_2_3, "Cross-conversation memory policy")
    }
    Strategy_Capability(cap5_3, "5.3 Conversation handling") {
      Strategy_Capability(cap5_3_1, "Domain & regime routing")
      Strategy_Capability(cap5_3_2, "Clarification & disambiguation")
      Strategy_Capability(cap5_3_3, "Multi-intent tracking")
      Strategy_Capability(cap5_3_4, "Conversation recovery")
      Strategy_Capability(cap5_3_5, "Interaction linkage")
    }
    Strategy_Capability(cap5_4, "5.4 Bot–human co-handling")
    Strategy_Capability(cap5_5, "5.5 Human review & approval")
    Strategy_Capability(cap5_6, "5.6 Outcome disposition")
    Strategy_Capability(cap5_7, "5.7 Conversation design governance")
  }
  Strategy_Capability(cap4, "4 Customer Interaction Management") {
    Strategy_Capability(cap4_1, "4.1 Journey & scope management")
    Strategy_Capability(cap4_2, "4.2 Multilingual & brand voice management")
    Strategy_Capability(cap4_3, "4.3 Accessibility & inclusion")
  }
}

Grouping(grp_assure, "Assure & Operate") {
  Strategy_Capability(cap8, "8 AI Operations & Incident Management") {
    Strategy_Capability(cap8_1, "8.1 AI incident management")
    Strategy_Capability(cap8_2, "8.2 Service continuity")
  }
  Strategy_Capability(cap7, "7 AI Quality Assurance") {
    Strategy_Capability(cap7_1, "7.1 Quality standard definition")
    Strategy_Capability(cap7_2, "7.2 Evaluation reference management")
    Strategy_Capability(cap7_3, "7.3 Release decision management")
    Strategy_Capability(cap7_4, "7.4 Solution effectiveness assessment")
    Strategy_Capability(cap7_5, "7.5 Adversarial resilience assurance")
    Strategy_Capability(cap7_6, "7.6 In-production quality monitoring")
  }
}

